{
  "workbench.colorTheme": "Dark+",
  "trailing-spaces.trimOnSave": true,
  "redhat.telemetry.enabled": true,
  "editor.tabSize": 2,
  "svg.preview.mode": "svg",
  "latex-workshop.latex.autoClean.run": "onSucceeded",
  "latex-workshop.latex.recipes": [
    {
      "name": "batch compile",
      "tools": [
        "lualatex",
        "lualatex",
        "lualatex"
      ]
    }
  ],
  "latex-workshop.latex.tools": [
    {
      "name": "lualatex",
      "command": "lualatex",
      "args": [
        "--cmdx",
        "-file-line-error",
        "-synctex=1",
        "-interaction=nonstopmode",
        "%DOC%"
      ]
    },
    {
      "name": "biber",
      "command": "biber",
      "args": [
        "-u",
        "-U",
        "--output-safechars",
        "%DOCFILE%"
      ]
    }
  ],
  "latex-workshop.latex.autoBuild.run": "onSave",
  "latex-workshop.latex.clean.fileTypes": [
    "%DOCFILE%.aux",
    "%DOCFILE%.bbl",
    "%DOCFILE%.bcf",
    "%DOCFILE%.blg",
    "%DOCFILE%.idx",
    "%DOCFILE%.ind",
    "%DOCFILE%.lof",
    "%DOCFILE%.lot",
    "%DOCFILE%.out",
    "%DOCFILE%.toc",
    "%DOCFILE%.acn",
    "%DOCFILE%.acr",
    "%DOCFILE%.alg",
    "%DOCFILE%.glg",
    "%DOCFILE%.glo",
    "%DOCFILE%.gls",
    "%DOCFILE%.fls",
    "%DOCFILE%.log",
    "%DOCFILE%.fdb_latexmk",
    "%DOCFILE%.run.xml",
    "%DOCFILE%.snm",
    "%DOCFILE%.synctex.gz",
    "%DOCFILE%.thm",
    "%DOCFILE%.nav",
    "%DOCFILE%.vrb"
  ],
  "editor.fontFamily": "Fira Code, 'Noto Sans Mono', 'Noto Sans TC', 'Noto Kufi Arabic', Unifont, monospace",
  "liveServer.settings.donotVerifyTags": true,
  "latex-workshop.latex.build.clearLog.everyRecipeStep.enabled": false,
  "latex-workshop.latex.autoBuild.cleanAndRetry.enabled": false,
  "[ruby]": {
    "editor.defaultFormatter": "Shopify.ruby-lsp",
    "editor.formatOnSave": true,
    "editor.formatOnType": true,
    "editor.tabSize": 2,
    "editor.insertSpaces": true,
    "files.trimTrailingWhitespace": true,
    "files.insertFinalNewline": true,
    "files.trimFinalNewlines": true,
    "editor.rulers": [
      120
    ],
    "editor.semanticHighlighting.enabled": true
  },
  "[css]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "javascript.preferences.quoteStyle": "single",
  "prisma.showPrismaDataPlatformNotification": false,
  "editor.defaultFormatter": "rheller.alive",
  "alive.lsp.startCommand": [
    "sbcl",
    "--eval",
    "(require :asdf)",
    "--eval",
    "(asdf:load-system :alive-lsp)",
    "--eval",
    "(alive/server:start)"
  ],
  "[typescriptreact]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[latex]": {
    "editor.defaultFormatter": "James-Yu.latex-workshop"
  },
  "[javascript]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[typst]": {
    "editor.defaultFormatter": "myriad-dreamin.tinymist",
    "editor.wordSeparators": "`~!@#$%^&*()=+[{]}\\|;:'\",.<>/?"
  },
  "[typescript]": {
    "editor.defaultFormatter": "denoland.vscode-deno"
  },
  "editor.unicodeHighlight.ambiguousCharacters": false,
  "[html]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[svelte]": {
    "editor.defaultFormatter": "svelte.svelte-vscode"
  },
  "[sass]": {
    "editor.defaultFormatter": "syler.sass-indented"
  },
  "[fsharp]": {
    "editor.defaultFormatter": "Ionide.Ionide-fsharp"
  },
  "files.watcherExclude": {
    "**/.bloop": true,
    "**/.metals": true,
    "**/.ammonite": true
  },
  "[scala]": {
    "editor.defaultFormatter": "scalameta.metals"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "eslint.format.enable": true,
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[elm]": {
    "editor.defaultFormatter": "elmTooling.elm-ls-vscode"
  },
  "[typst-code]": {
    "editor.wordSeparators": "`~!@#$%^&*()=+[{]}\\|;:'\",.<>/?"
  },
  "idris2.serverRestartService.toggle": true,
  "[yaml]": {
    "editor.defaultFormatter": "redhat.vscode-yaml"
  },
  "[swift]": {
    "editor.defaultFormatter": "vknabel.vscode-apple-swift-format"
  },
  "diffEditor.experimental.showMoves": true,
  "terminal.integrated.fontFamily": "MesloLGS NF",
  "diffEditor.codeLens": true,
  "calva.prettyPrintingOptions": {
    "printEngine": "pprint",
    "enabled": true,
    "width": 120,
    "maxLength": 50
  },
  "workbench.editorAssociations": {
    "*.svg": "default"
  },
  "[svg]": {
    "editor.defaultFormatter": "jock.svg"
  },
  "lean4.alwaysAskBeforeInstallingLeanVersions": true,
  "lean4.automaticallyBuildDependencies": true,
  "docker.extension.enableComposeLanguageServer": false,
  "[rust]": {
    "editor.defaultFormatter": "rust-lang.rust-analyzer"
  },
  "editor.formatOnSave": true,
  "github.copilot.nextEditSuggestions.enabled": true,
  "[purescript]": {
    "editor.defaultFormatter": "mvakula.vscode-purty"
  },
  "[markdown]": {
    "editor.defaultFormatter": "denoland.vscode-deno"
  },
  "[jade]": {
    "editor.defaultFormatter": "ducfilan.pug-formatter"
  },
  "[astro]": {
    "editor.defaultFormatter": "astro-build.astro-vscode"
  },
  "[haskell]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "haskell.haskell"
  },
  "haskell.manageHLS": "GHCup",
  "jupyter.enableExtendedPythonKernelCompletions": true,
  "python.analysis.autoImportCompletions": true,
  "python.analysis.completeFunctionParens": true,
  "standard.engine": "ts-standard",
  "standard.autoFixOnSave": true,
  "javascript.updateImportsOnFileMove.enabled": "always",
  "gitlens.ai.model": "vscode",
  "gitlens.ai.vscode.model": "copilot:gpt-4.1",
  "chat.tools.terminal.autoApprove": {
    "runhaskell": true
  },
  "oxc.typeAware": true,
  "claudeCode.preferredLocation": "panel",
  "[scss]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "http.systemCertificatesNode": true,
  "terminal.integrated.commandsToSkipShell": [
    "language-julia.interrupt"
  ],
  "julia.symbolCacheDownload": true,
  "[python]": {
    "editor.defaultFormatter": "ms-python.autopep8"
  },
  "[flix]": {
    "editor.defaultFormatter": "flix.flix"
  }
}
